# Copy to .env locally; set these individually in Vercel. Never commit real values.
DATA_MODE=supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=
# Legacy service_role JWT also works in SUPABASE_SECRET_KEY. Never use an anon key.
SESSION_SECRET=
APP_URL=http://localhost:3000
STUDENT_NAME=Your name
GITHUB_REPO_URL=
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the PEM key; escaped \n is supported.
GOOGLE_PRIVATE_KEY=
CRON_SECRET=
# Optional shared classroom access code; leave empty for the required open role selector.
DEMO_ACCESS_CODE=
# Local-only preview: DATA_MODE=local and MOCK_INTEGRATIONS=true.
MOCK_INTEGRATIONS=false
